# LLM Provider: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud LLM settings (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database paths
SQLITE_DB_PATH=data/db/netlist.db
CHROMA_DB_PATH=data/db/chroma

# File paths
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Default output format: spice | edif | kicad | json
DEFAULT_OUTPUT_FORMAT=spice
